<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632;CS8618;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8629;CS8765;CS0114;CS0108;CS0168;CS1998;CS0414;CS0652;SYSLIB0051;SYSLIB0053;SYSLIB0022;CA2022</NoWarn>
    <WarningsAsErrors />
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Platform-specific protobuf configuration for .NET 9 -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">
    <!-- On Apple Silicon, disable automatic protobuf generation -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Re-enable compile items but exclude generated files -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">
    <Compile Include="**/*.cs" Exclude="bin/**;obj/**;WAProto.cs;WhisperTextProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Core\Events\NodeEventStore.cs" />
    <Compile Remove="Core\Stores\AppStateSyncKeyStore.cs" />
    <Compile Remove="Core\Stores\AppStateSyncVersionStore.cs" />
    <Compile Remove="Core\Stores\KeyStore.cs" />
    <Compile Remove="Core\Stores\SenderKeyStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Core\HandshakeMessage.proto" />
    <None Remove="Proto\WAProto.3.proto" />
    <None Remove="Proto\WhisperTextProtocol.proto" />
    <None Remove="Resources\mimeTypes.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFMpegCore" Version="5.1.0" />
    <PackageReference Include="Google.Protobuf" Version="3.27.0" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="LiteDB" Version="5.0.20" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
  </ItemGroup>

  <!-- Protobuf generation for non-ARM64 macOS (.NET 9 compatible) -->
  <ItemGroup Condition="!($([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64')">
    <Protobuf Include="Proto\WAProto.proto" />
    <Protobuf Include="Proto\WhisperTextProtocol.proto" />
  </ItemGroup>

  <!-- Manual protobuf generation for ARM64 macOS (.NET 9 compatible) -->
  <Target Name="GenerateProtobufForArm64" BeforeTargets="BeforeBuild" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">
    <Message Text="Generating protobuf files for ARM64 macOS using system protoc (.NET 9)..." Importance="high" />
    <Exec Command="protoc --csharp_out=. Proto/WAProto.proto Proto/WhisperTextProtocol.proto" 
          WorkingDirectory="$(MSBuildProjectDirectory)" 
          Condition="Exists('/opt/homebrew/bin/protoc')" />
    <ItemGroup>
      <Compile Include="WAProto.cs" Condition="Exists('$(MSBuildProjectDirectory)/WAProto.cs')" />
      <Compile Include="WhisperTextProtocol.cs" Condition="Exists('$(MSBuildProjectDirectory)/WhisperTextProtocol.cs')" />
    </ItemGroup>
  </Target>


  <ItemGroup>
    <EmbeddedResource Include="Resources\mimeTypes.json" />
  </ItemGroup>

</Project>
